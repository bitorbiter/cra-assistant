# Copy to .env and fill in. .env is gitignored and must never be committed.
# It is read from the repository root at startup; an exported environment
# variable always wins over a value in this file.
#
# Key material is also never logged: no API key may appear in log output,
# traces, error messages or test fixtures. Log the fact that a key was used,
# never the key itself.

OPENAI_API_KEY=

# Optional. Raises GitHub's unauthenticated rate limit of 60 requests an hour
# when fetching untrusted sources. Public data either way; only the limit changes.
GITHUB_TOKEN=

# Optional. Overrides the default model.
CRA_MODEL=
